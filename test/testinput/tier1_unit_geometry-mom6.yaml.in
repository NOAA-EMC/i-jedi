geometry:
  geometry_type: mom6
  input_dir: @MOM6_TESTDATA_DIR@
  coarsen factor: 1
  save unstructured grid to: mom6_grid.nc
  save structured grid to: mom6_structured_grid.nc
  save debug mesh to: mom6_grid_debug
  check scatter map: true

  MOM_input:
    NIGLOBAL: 72
    NJGLOBAL: 35
    NZ: 25
    LAYOUT: [3, 2]
    MINIMUM_DEPTH: 0.5

