geometry:
  geometry_type: mom6
  input_dir: @MOM6_HIRES_STAGING@
  coarsen factor: 2

  MOM_input:
    NIGLOBAL: 1440
    NJGLOBAL: 1080
    NZ: 15
    LAYOUT: [3, 2]
    MINIMUM_DEPTH: 0.5

background:
  date: "2020-01-01T00:00:00Z"
  variables: [tocn, socn]
  analytic init: true

analysis variables: [tocn, socn]

background error:
  covariance model: SABER
  saber central block:
    saber block name: diffusion
    read:
      groups:
      - variables: [tocn, socn]
        multivariate strategy: univariate
        horizontal:
          filepath: hires_diffusion_hz
        vertical:
          levels: 15
          filepath: hires_diffusion_vt

dirac:
  indices: 100
  level: 1
  variable: tocn

output dirac:
  file format: fieldset
  filepath: hires_dirac_diffusion_mom6_%id%
