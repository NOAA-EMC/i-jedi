geometry:
  geometry_type: mom6
  input_dir: @MOM6_TESTDATA_DIR@
  coarsen factor: 1

  MOM_input:
    NIGLOBAL: 72
    NJGLOBAL: 35
    NZ: 25
    LAYOUT: [3, 2]
    MINIMUM_DEPTH: 0.5

background:
  date: "2020-01-01T00:00:00Z"
  variables: [tocn, socn]
  analytic init: true

analysis variables: [tocn, socn]

background error:
  covariance model: SABER
  saber central block:
    saber block name: diffusion
    read:
      groups:
      - variables: [tocn, socn]
        multivariate strategy: univariate
        horizontal:
          filepath: diffusion_hz
        vertical:
          levels: 25
          filepath: diffusion_vt

dirac:
  indices: 10
  level: 1
  variable: tocn

output dirac:
  file format: fieldset
  filepath: dirac_diffusion_mom6_%id%
