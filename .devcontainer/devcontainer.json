{
  "name": "ijedi",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "USERNAME": "builder"
    },
    "context": ".."
  },
  "remoteUser": "builder",
  "customizations": {
    "vscode": {
      "extensions": [],
      "settings": {
        "editor.formatOnSave": false,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "[python]": {}
      }
    }
  },
  "postCreateCommand": "echo \"Container setup complete\"",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=/home/builder/,type=bind,consistency=cached"
  ]
}
